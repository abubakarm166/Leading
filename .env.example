# Copy to .env.dev / .env.prod and fill in values.
# Never commit real secrets.

NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_MAIL_ADDRESS=
NEXT_PUBLIC_MAIL_AUTH=

# When set, overrides the default GTM container. Default in code: GTM-58DF5MRB
# Configure GA4 / Google Ads / conversions / call tracking inside GTM (not hard-coded gtag).
NEXT_PUBLIC_GTM_ID=GTM-58DF5MRB
